# Overlay for espressif/esp-hosted-mcu v2.12.12 / slave, target esp32c5.
# Apply AFTER upstream sdkconfig.defaults and sdkconfig.defaults.esp32c5.
# Board SDIO mapping is documented in CloudZao/MetalioClaw4 README section 7.2.
CONFIG_ESP_HOST_DEV_BOARD_NONE=y
CONFIG_ESP_SDIO_HOST_INTERFACE=y
CONFIG_ESP_SDIO_HIGH_SPEED=y
CONFIG_ESP_SDIO_PSEND_PSAMPLE=y
CONFIG_ESP_SDIO_STREAMING_MODE=y
CONFIG_ESP_SDIO_GPIO_RESET=-1
CONFIG_ESP_SDIO_PIN_CMD=10
CONFIG_ESP_SDIO_PIN_CLK=9
CONFIG_ESP_SDIO_PIN_D0=8
CONFIG_ESP_SDIO_PIN_D1=7
CONFIG_ESP_SDIO_PIN_D2=14
CONFIG_ESP_SDIO_PIN_D3=13

# Wi-Fi plus a controller exported to the P4's NimBLE host over SDIO.
CONFIG_ESP_HOSTED_CP_WIFI=y
CONFIG_ESP_HOSTED_CP_BT=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y
CONFIG_BT_LE_HCI_INTERFACE_USE_UART=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_HOSTED_NETWORK_SPLIT_ENABLED=n
CONFIG_ESP_HOSTED_HOST_POWER_SAVE_ENABLED=n
CONFIG_ESP_HOSTED_LIGHT_SLEEP_ENABLE=n
CONFIG_PM_ENABLE=n

# Match upstream's 4 MB two-OTA layout; physical C5 flash/recovery remains
# to be checked on the specific Claw4 unit before any manual flashing.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0xc000
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.esp32c5.csv"
